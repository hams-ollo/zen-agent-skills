{
  "_comment": [
    "Codex wiring for the .agents/hooks/ module. Repo-scoped: active when working in a",
    "repository that ships .agents/hooks/, and inert everywhere else.",
    "",
    "The matcher is deliberately broad. Each hook re-checks the tool name against its own",
    "precise set, so a matcher that catches more than it should cannot cause a false fire.",
    "See .agents/hooks/README.md for the module contract."
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/skill-reachability-reminder.py\"",
            "statusMessage": "Skill reachability",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Task$|^Agent$|^TaskOutput$|agent_run",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/delegation-reminder.py\"",
            "statusMessage": "Delegation checkpoint",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "apply_patch|^Edit$|^Write$|^MultiEdit$|^NotebookEdit$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/spec-conformance-gate.py\"",
            "statusMessage": "Spec-closeout gate",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
