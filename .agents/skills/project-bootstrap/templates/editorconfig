# House .editorconfig for project-bootstrap.
#
# Emitted into the target repo as .editorconfig. Consistent whitespace across every
# editor that reads the format. Edit this file to change the kit-wide default, or edit
# the emitted .editorconfig per repo. An existing .editorconfig is never overwritten.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,html,md,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
